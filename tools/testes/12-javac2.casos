### e-main-sem-static-chamada
public class Main {
    int idade = 10;
    void mostrar() { System.out.println(idade); }
    public static void main(String[] args) {
        mostrar();
        idade = 5;
    }
}
### e-inner-sem-instancia
public class Main {
    class Ajudante { }
    public static void main(String[] args) {
        Ajudante a = new Ajudante();
    }
}
### e-retorno-faltando-if
public class Main {
    static String classifica(int n) {
        if (n > 0) return "positivo";
        else if (n < 0) return "negativo";
    }
    public static void main(String[] args) { }
}
### e-var-fora-escopo
public class Main {
    public static void main(String[] args) {
        for (int i = 0; i < 3; i++) {
            int dobro = i * 2;
        }
        System.out.println(i);
        System.out.println(dobro);
    }
}
### e-tipos-metodo
public class Main {
    static int dobro(int x) { return x * 2; }
    public static void main(String[] args) {
        String s = dobro(5);
        int r = dobro("5");
        double d = dobro(2.5);
    }
}
### e-booleano-numero
public class Main {
    public static void main(String[] args) {
        int x = 5;
        if (x) System.out.println("a");
        boolean b = 1;
        while (x = 0) { }
    }
}
### e-lossy
public class Main {
    public static void main(String[] args) {
        double preco = 9.99;
        int inteiro = preco;
        long grande = 10;
        int i = grande * 2;
        float f = 2.5;
        byte b = 200;
        char c = 'a' + 1;
        short s = 5;
        s = s + 1;
    }
}
### e-final-param
public class Main {
    static void f(final int x) { x = 2; }
    public static void main(String[] args) {
        final String nome = "Ana";
        nome = "Bia";
        final int[] v = new int[2];
        v = new int[3];
    }
}
### e-construtor-tipo-retorno
