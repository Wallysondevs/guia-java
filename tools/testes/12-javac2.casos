### e-sealed-fora
public class Main {
    sealed interface Forma permits Circulo {}
    record Circulo() implements Forma {}
    record Quadrado() implements Forma {}
    public static void main(String[] args) { }
}
### e-switch-duplicado
public class Main {
    public static void main(String[] args) {
        int x = 1;
        switch (x) {
            case 1: break;
            case 1: break;
        }
        String s = switch (x) { case 1 -> "a"; case 2 -> 5; default -> "c"; };
    }
}
### e-enum-switch
public class Main {
    enum Cor { VERDE, AZUL }
    public static void main(String[] args) {
        Cor c = Cor.VERDE;
        String n = switch (c) { case VERDE -> "v"; };
    }
}
### e-checked-metodo
import java.io.*;
public class Main {
    static void ler() throws IOException { throw new IOException("x"); }
    public static void main(String[] args) {
        ler();
    }
}
### e-checked-lambda
import java.util.*;
public class Main {
    static void ler(String s) throws Exception { }
    public static void main(String[] args) {
        List.of("a").forEach(s -> ler(s));
    }
}
### e-instanceof-padrao-escopo
public class Main {
    public static void main(String[] args) {
        Object o = "x";
        if (o instanceof String s) System.out.println(s);
        System.out.println(s.length());
    }
}
### e-generic-raw-lista
import java.util.*;
public class Main {
    public static void main(String[] args) {
        List<String> l = new ArrayList<>();
        l.add("a");
        int n = l.get(0);
        Map<String, Integer> m = new HashMap<>();
        m.put(1, "um");
    }
}
### e-metodo-inexistente-objeto
import java.util.*;
public class Main {
    public static void main(String[] args) {
        ArrayList<String> l = new ArrayList<>();
        l.push("a");
        l.length();
        String[] a = {};
        System.out.println(a.length());
        int x = 5;
        x.toString();
    }
}
