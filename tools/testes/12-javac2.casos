### e-acesso-protegido-ok
public class Main {
    static class A { protected int x = 1; private int y = 2; }
    static class B extends A { int soma() { return x + super.x; } }
    public static void main(String[] args) {
        System.out.println(new B().soma() + new A().y);
    }
}
