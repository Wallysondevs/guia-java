### e-metodo-generico-limite
import java.util.*;
public class Main {
    static <T extends Comparable<T>> T maior(List<T> l) { return l.get(0); }
    static class Caixa {}
    public static void main(String[] args) {
        maior(List.of(new Caixa()));
    }
}
