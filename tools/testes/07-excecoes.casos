    static class Config { static int v = 10 / Integer.parseInt("0"); }
    public static void main(String[] args) {
        System.out.println("antes");
        System.out.println(Config.v);
    }
}
### assert-desligado
public class Main {
    public static void main(String[] args) {
        int x = -1;
        assert x > 0 : "x deve ser positivo";
        System.out.println("passou " + x);
    }
}
