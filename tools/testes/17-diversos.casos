    }
}
### reflexao-basica
import java.util.*;
public class Main {
    static class Animal {}
    static class Cao extends Animal {}
    public static void main(String[] args) {
        Animal a = new Cao();
        System.out.println(a.getClass().getSimpleName() + " " + Cao.class.getSuperclass().getSimpleName() + " " + a.getClass().getName() + " " + Animal.class.getSuperclass().getName());
        System.out.println(new ArrayList<String>().getClass().getSimpleName() + " " + "x".getClass() + " " + int.class + " " + String[].class.getSimpleName() + " " + Integer.valueOf(1).getClass().getName());
        System.out.println(a instanceof Cao c ? c.getClass().getSimpleName() : "-");
        Object o = List.of(1);
        System.out.println(o.getClass().getSimpleName().startsWith("List"));
    }
}
