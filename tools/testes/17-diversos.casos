### switch-double
public class Main {
    public static void main(String[] args) {
        double d = 1.5;
        switch (d) {
            case 1.5 -> System.out.println("x");
            default -> System.out.println("y");
        }
    }
}
### switch-boolean
public class Main {
    public static void main(String[] args) {
        boolean b = true;
        String s = switch (b) { case true -> "s"; case false -> "n"; };
    }
}
### switch-long
public class Main {
    public static void main(String[] args) {
        long l = 5;
