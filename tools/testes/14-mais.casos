### ordem-inicializacao-heranca
public class Main {
    static class Base {
        Base() { System.out.println("Base: " + descricao()); }
        String descricao() { return "base"; }
    }
    static class Filha extends Base {
        private String nome = "filha";
        private int n = 5;
        Filha() { System.out.println("Filha: " + descricao()); }
        @Override String descricao() { return nome + " " + n; }
    }
    public static void main(String[] args) { new Filha(); }
}
### interface-privado-estatico
public class Main {
    interface Calc {
        int calcular(int x);
        default int dobro(int x) { return ajuda(calcular(x)) * 2; }
        private int ajuda(int x) { return x + 0; }
        static Calc quadrado() { return x -> x * x; }
    }
    public static void main(String[] args) {
        Calc c = Calc.quadrado();
        System.out.println(c.calcular(4) + " " + c.dobro(3));
    }
}
### interna-acessa-externa
public class Main {
    private String nome = "Ana";
    private static int total = 0;
    class Interna {
        String nome = "interna";
        String mostrar() { total++; return nome + " / " + Main.this.nome + " / " + total; }
    }
    static class Estatica { String oi() { return "total=" + total; } }
    public static void main(String[] args) {
        Main m = new Main();
        Interna i = m.new Interna();
        System.out.println(i.mostrar());
        System.out.println(i.mostrar());
        System.out.println(new Estatica().oi());
    }
}
