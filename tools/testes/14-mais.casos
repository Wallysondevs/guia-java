### treemap-contagem
import java.util.*;
public class Main {
    public static void main(String[] args) {
        String texto = "Java é uma linguagem; Java roda na JVM, e a JVM roda Java.";
        Map<String, Integer> cont = new TreeMap<>();
        for (String p : texto.toLowerCase().split("[^\\p{L}]+")) if (!p.isEmpty()) cont.merge(p, 1, Integer::sum);
        System.out.println(cont);
        Map<Integer, List<String>> porTamanho = new TreeMap<>(Comparator.reverseOrder());
        for (String p : cont.keySet()) porTamanho.computeIfAbsent(p.length(), k -> new ArrayList<>()).add(p);
        System.out.println(porTamanho);
    }
}
### streams-numeros
import java.util.*;
import java.util.stream.*;
public class Main {
    public static void main(String[] args) {
        System.out.println(IntStream.rangeClosed(1, 10).filter(i -> i % 2 == 1).sum());
        System.out.println(IntStream.rangeClosed(1, 5).map(i -> i * i).boxed().collect(Collectors.toList()));
        System.out.println(IntStream.of(5, 2, 8).max().getAsInt() + " " + IntStream.empty().max().isPresent() + " " + IntStream.range(0, 0).average());
        System.out.println(Stream.of(1, 2, 3, 4).mapToDouble(i -> i / 2.0).boxed().toList());
        double[] notas = {7.5, 8.0, 9.25};
        System.out.println(Arrays.stream(notas).average().orElse(0) + " " + Arrays.stream(notas).map(n -> n + 0.5).max().getAsDouble());
        List<Integer> l = Stream.of(3, 1, 2).sorted().collect(Collectors.toList());
        l.add(4);
        System.out.println(l + " " + l.stream().mapToInt(Integer::intValue).summaryStatistics().getAverage());
        System.out.println(Stream.of("a", "b", "c").reduce("", String::concat) + " " + Stream.of(1, 2, 3).map(String::valueOf).reduce((a, b) -> a + "," + b).get());
        System.out.println(IntStream.iterate(1, i -> i * 3).limit(5).mapToObj(Integer::toString).collect(Collectors.joining(" < ")));
    }
}
### streams-objetos
import java.util.*;
import java.util.stream.*;
public class Main {
    record Pessoa(String nome, int idade, String cidade) {}
    public static void main(String[] args) {
        List<Pessoa> ps = List.of(new Pessoa("Ana", 29, "Recife"), new Pessoa("Bruno", 34, "Natal"), new Pessoa("Carla", 22, "Recife"), new Pessoa("Diego", 41, "Olinda"), new Pessoa("Elisa", 30, "Natal"));
        System.out.println(ps.stream().filter(p -> p.idade() >= 30).map(Pessoa::nome).toList());
        System.out.println(ps.stream().mapToInt(Pessoa::idade).average().getAsDouble());
        System.out.println(ps.stream().max(Comparator.comparingInt(Pessoa::idade)).map(Pessoa::nome).orElse("?"));
        Map<String, Long> porCidade = ps.stream().collect(Collectors.groupingBy(Pessoa::cidade, TreeMap::new, Collectors.counting()));
        System.out.println(porCidade);
        Map<String, List<String>> nomesPorCidade = ps.stream().collect(Collectors.groupingBy(Pessoa::cidade, Collectors.mapping(Pessoa::nome, Collectors.toList())));
        System.out.println(nomesPorCidade);
        Map<Boolean, List<String>> adultos30 = ps.stream().collect(Collectors.partitioningBy(p -> p.idade() < 30, Collectors.mapping(Pessoa::nome, Collectors.toList())));
        System.out.println(adultos30);
        String nomes = ps.stream().sorted(Comparator.comparing(Pessoa::cidade).thenComparing(Pessoa::idade, Comparator.reverseOrder())).map(p -> p.nome() + "/" + p.cidade()).collect(Collectors.joining(", "));
        System.out.println(nomes);
        System.out.println(ps.stream().anyMatch(p -> p.cidade().equals("Olinda")) + " " + ps.stream().map(Pessoa::cidade).distinct().count());
        Optional<Pessoa> primeiro = ps.stream().filter(p -> p.nome().startsWith("C")).findFirst();
        System.out.println(primeiro.map(Pessoa::idade).orElse(-1));
    }
}
