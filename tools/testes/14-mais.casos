### varargs-casos
public class Main {
    static int soma(int... n) { int s = 0; for (int x : n) s += x; return s; }
    static String juntar(String sep, String... partes) { return String.join(sep, partes); }
    static void info(Object... o) { System.out.println(o == null ? "null" : o.length + " argumentos"); }
    public static void main(String[] args) {
        System.out.println(soma() + " " + soma(1) + " " + soma(1, 2, 3) + " " + soma(new int[]{4, 5}));
        System.out.println(juntar("-", "a", "b", "c") + " " + juntar(","));
        info(); info(1, "a"); info((Object[]) null); info((Object) null); info(new String[]{"x", "y"});
    }
}
### array-objetos
public class Main {
    record Aluno(String nome, double nota) {}
    public static void main(String[] args) {
        Aluno[] turma = new Aluno[3];
        turma[0] = new Aluno("Ana", 9);
        turma[2] = new Aluno("Bruno", 7);
        double soma = 0; int n = 0;
        for (Aluno a : turma) if (a != null) { soma += a.nota(); n++; }
        System.out.println(soma / n + " " + java.util.Arrays.toString(turma));
        int[][] tab = new int[3][4];
        for (int i = 0; i < 3; i++) for (int j = 0; j < 4; j++) tab[i][j] = i * j;
        for (int[] linha : tab) { for (int v : linha) System.out.print(v + "\t"); System.out.println(); }
        char[][] velha = {{'X', 'O', ' '}, {' ', 'X', 'O'}, {'O', ' ', 'X'}};
        for (char[] l : velha) System.out.println(new String(l).replace(' ', '_'));
    }
}
### matriz-soma
public class Main {
    public static void main(String[] args) {
        int[][] a = {{1, 2}, {3, 4}}, b = {{5, 6}, {7, 8}};
        int[][] c = new int[2][2];
        for (int i = 0; i < 2; i++) for (int j = 0; j < 2; j++) for (int k = 0; k < 2; k++) c[i][j] += a[i][k] * b[k][j];
        System.out.println(java.util.Arrays.deepToString(c));
        int maior = Integer.MIN_VALUE;
        for (int[] l : c) for (int v : l) maior = Math.max(maior, v);
        System.out.println(maior);
    }
}
### busca-ordenacao
public class Main {
    static void bolha(int[] v) {
        for (int i = 0; i < v.length - 1; i++)
            for (int j = 0; j < v.length - 1 - i; j++)
                if (v[j] > v[j + 1]) { int t = v[j]; v[j] = v[j + 1]; v[j + 1] = t; }
    }
    static int binaria(int[] v, int x) {
        int lo = 0, hi = v.length - 1;
        while (lo <= hi) { int m = (lo + hi) / 2; if (v[m] == x) return m; if (v[m] < x) lo = m + 1; else hi = m - 1; }
        return -1;
    }
    public static void main(String[] args) {
        int[] v = {9, 4, 7, 1, 8, 2};
        bolha(v);
        System.out.println(java.util.Arrays.toString(v) + " " + binaria(v, 7) + " " + binaria(v, 5));
    }
}
### primos-fizzbuzz
public class Main {
    static boolean primo(int n) { if (n < 2) return false; for (int i = 2; i * i <= n; i++) if (n % i == 0) return false; return true; }
    public static void main(String[] args) {
        StringBuilder sb = new StringBuilder();
        for (int i = 1; i <= 30; i++) if (primo(i)) sb.append(i).append(' ');
        System.out.println(sb.toString().trim());
        for (int i = 1; i <= 15; i++) System.out.print(i % 15 == 0 ? "FizzBuzz " : i % 3 == 0 ? "Fizz " : i % 5 == 0 ? "Buzz " : i + " ");
        System.out.println();
        long soma = 0;
        for (int i = 1; i <= 1000000; i++) soma += i;
        System.out.println(soma);
    }
}
### string-palindromo
public class Main {
    static boolean palindromo(String s) {
        String limpo = s.toLowerCase().replaceAll("[^a-z]", "");
        return new StringBuilder(limpo).reverse().toString().equals(limpo);
    }
    public static void main(String[] args) {
        for (String s : new String[]{"Arara", "A man, a plan, a canal: Panama", "Java"}) System.out.println(s + " -> " + palindromo(s));
        String frase = "a vida é bela";
        String[] palavras = frase.split(" ");
        StringBuilder inv = new StringBuilder();
        for (int i = palavras.length - 1; i >= 0; i--) inv.append(palavras[i]).append(i > 0 ? " " : "");
        System.out.println(inv);
        int vogais = 0;
        for (char c : frase.toCharArray()) if ("aeiouáéíóú".indexOf(c) >= 0) vogais++;
        System.out.println(vogais);
    }
}
### string-format-tabela
public class Main {
    public static void main(String[] args) {
        String[][] dados = {{"Café", "12.5", "3"}, {"Pão de queijo", "8", "10"}, {"Suco", "6.75", "2"}};
        System.out.println(String.format("%-15s %8s %5s %10s", "Produto", "Preço", "Qtd", "Total"));
        double geral = 0;
        for (String[] d : dados) {
            double p = Double.parseDouble(d[1]); int q = Integer.parseInt(d[2]);
            geral += p * q;
            System.out.println(String.format("%-15s %8.2f %5d %10.2f", d[0], p, q, p * q));
        }
        System.out.println(String.format("%-15s %25.2f", "TOTAL", geral));
        System.out.println(String.format("|%10s|%-10s|%.3s|", "dir", "esq", "corte"));
    }
}
### excecao-aninhada
public class Main {
    public static void main(String[] args) {
        try {
            try {
                Object o = "x";
                Integer i = (Integer) o;
            } catch (ClassCastException e) {
                System.out.println("interno: " + e.getClass().getSimpleName());
                throw new IllegalStateException("convertido", e);
            } finally {
                System.out.println("finally interno");
            }
        } catch (IllegalStateException e) {
            System.out.println("externo: " + e.getMessage() + " causa=" + e.getCause().getClass().getName());
        }
        try {
            throw new UnsupportedOperationException();
        } catch (RuntimeException e) {
            System.out.println(e + " msg=" + e.getMessage());
        }
    }
}
