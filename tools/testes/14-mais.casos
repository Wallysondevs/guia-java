}
### compound-char-byte
public class Main {
    public static void main(String[] args) {
        byte b = 120;
        b += 10;
        short s = 1;
        s *= 1000;
        s *= 100;
        char c = 'a';
        c *= 2;
        int i = 7;
        i /= 2.0;
        long l = 1;
        l <<= 40;
        int sh = 1 << 33;
        System.out.println(b + " " + s + " " + (int) c + " " + i + " " + l + " " + sh + " " + (-1 >>> 1) + " " + (-1L >>> 1));
        Integer w = 5;
        w++;
        w += 10;
        System.out.println(w);
    }
}
### string-switch-yield
public class Main {
    static int pontos(String jogada) {
        return switch (jogada.toLowerCase()) {
            case "pedra" -> 1;
            case "papel" -> 2;
            case "tesoura" -> {
                int base = 3;
                yield base;
            }
            default -> throw new IllegalArgumentException("jogada inválida: " + jogada);
        };
    }
    public static void main(String[] args) {
        System.out.println(pontos("Pedra") + pontos("PAPEL") + pontos("tesoura"));
        System.out.println(pontos("lagarto"));
    }
}
### do-while-menu [stdin="2\n5\n1\n0\n"]
import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int op, total = 0;
        do {
            System.out.println("1-Somar 2-Dobrar 0-Sair (total=" + total + ")");
            op = sc.nextInt();
            switch (op) {
                case 1 -> total++;
                case 2 -> total = total * 2 + 1;
                case 0 -> System.out.println("tchau");
                default -> System.out.println("opção inválida");
            }
        } while (op != 0);
        System.out.println(total);
    }
}
### media-scanner [stdin="4\n7,5\n8\n9,25\n6\n"]
import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Quantas notas? ");
        int n = sc.nextInt();
        double soma = 0;
        for (int i = 1; i <= n; i++) { System.out.print("Nota " + i + ": "); soma += sc.nextDouble(); }
        System.out.printf("%nMédia: %.2f%n", soma / n);
        System.out.println(soma / n >= 7 ? "Aprovado" : "Reprovado");
    }
}
