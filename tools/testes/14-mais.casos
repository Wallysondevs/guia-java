### e-metodo-abstrato-classe-concreta
public class Main {
    static class Animal { abstract void som(); }
    public static void main(String[] args) { }
}
### e-super-depois
public class Main {
    static class A { A(int x) {} }
    static class B extends A {
        int y;
        B() { y = 1; super(2); }
    }
    public static void main(String[] args) { }
}
### e-this-no-prologo
public class Main {
    static class A { A(int x) {} }
    static class B extends A {
        int y = 5;
        B() { super(y); }
    }
    public static void main(String[] args) { }
}
