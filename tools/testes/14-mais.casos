### enum-interface-switch
public class Main {
    interface Descrito { String descricao(); }
    enum Tamanho implements Descrito {
        P("pequeno"), M("médio"), G("grande");
        private final String d;
        Tamanho(String d) { this.d = d; }
        public String descricao() { return d; }
        Tamanho proximo() { return values()[(ordinal() + 1) % values().length]; }
    }
    public static void main(String[] args) {
        for (Tamanho t : Tamanho.values()) {
            switch (t) {
                case P: System.out.print("P:"); break;
                case M: System.out.print("M:"); break;
                default: System.out.print("?:");
            }
            System.out.println(t.descricao() + " -> " + t.proximo());
        }
        System.out.println(Tamanho.valueOf("G").compareTo(Tamanho.P) + " " + Tamanho.M.equals(Tamanho.valueOf("M")) + " " + (Tamanho.M == Tamanho.valueOf("M")));
    }
}
### record-comparable
import java.util.*;
public class Main {
    record Versao(int maior, int menor) implements Comparable<Versao> {
        static final Versao ZERO = new Versao(0, 0);
        public int compareTo(Versao o) { return maior != o.maior ? Integer.compare(maior, o.maior) : Integer.compare(menor, o.menor); }
        @Override public String toString() { return maior + "." + menor; }
    }
    public static void main(String[] args) {
        List<Versao> vs = new ArrayList<>(List.of(new Versao(1, 10), new Versao(1, 2), new Versao(0, 9), Versao.ZERO));
        Collections.sort(vs);
        System.out.println(vs + " " + Collections.max(vs) + " " + new TreeSet<>(vs).first());
    }
}
### generics-pilha
import java.util.*;
public class Main {
    static class Pilha<T> implements Iterable<T> {
        private final List<T> itens = new ArrayList<>();
        void empilhar(T t) { itens.add(t); }
        T desempilhar() { if (itens.isEmpty()) throw new RuntimeException("pilha vazia"); return itens.remove(itens.size() - 1); }
        boolean vazia() { return itens.isEmpty(); }
        public Iterator<T> iterator() { return itens.iterator(); }
        static <E> Pilha<E> de(E... es) { Pilha<E> p = new Pilha<>(); for (E e : es) p.empilhar(e); return p; }
    }
    public static void main(String[] args) {
        Pilha<String> p = Pilha.de("a", "b", "c");
        for (String s : p) System.out.print(s);
        System.out.println();
        while (!p.vazia()) System.out.print(p.desempilhar());
        System.out.println();
        p.desempilhar();
    }
}
### generics-bounded
import java.util.*;
public class Main {
    static <T extends Number> double media(List<T> l) { double s = 0; for (T x : l) s += x.doubleValue(); return l.isEmpty() ? 0 : s / l.size(); }
    static <K, V extends Comparable<V>> K maiorChave(Map<K, V> m) {
        K melhor = null; V mv = null;
        for (Map.Entry<K, V> e : m.entrySet()) if (mv == null || e.getValue().compareTo(mv) > 0) { mv = e.getValue(); melhor = e.getKey(); }
        return melhor;
    }
    public static void main(String[] args) {
        System.out.println(media(List.of(1, 2, 3, 4)) + " " + media(List.of(2.5, 3.5)) + " " + media(new ArrayList<Long>()));
        Map<String, Integer> pontos = new TreeMap<>(Map.of("Ana", 30, "Bruno", 45, "Carla", 12));
        System.out.println(maiorChave(pontos));
    }
}
### hashmap-inteiros-grandes
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Map<Integer, String> m = new HashMap<>();
        int[] ks = {100, 33, 17, 65, 1, 129, 1024, 48, 2000, 77, 5, 300, 64, 12, 999};
        for (int k : ks) m.put(k, "v" + k);
        System.out.println(m);
        m.remove(65); m.remove(1024);
        System.out.println(m.keySet());
        Set<Character> cs = new HashSet<>();
        for (char c : "programação em java".toCharArray()) cs.add(c);
        System.out.println(cs);
        Set<Double> ds = new HashSet<>(List.of(1.5, 2.0, -0.5, 100.25, 3.14));
        System.out.println(ds);
        Set<Long> ls = new HashSet<>(List.of(10L, 5000000000L, -1L));
        System.out.println(ls);
        Set<Boolean> bs = new HashSet<>(List.of(true, false));
        System.out.println(bs);
    }
}
