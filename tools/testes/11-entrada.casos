### scanner-linhas [stdin="Ana Souza\n29\n1,75\nsim\n"]
import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Nome: ");
        String nome = sc.nextLine();
        System.out.print("Idade: ");
        int idade = sc.nextInt();
        System.out.print("Altura: ");
        double alt = sc.nextDouble();
        sc.nextLine();
        System.out.print("Confirma? ");
        String r = sc.nextLine();
        System.out.println();
        System.out.printf("%s, %d anos, %.2f m, %s%n", nome, idade, alt, r);
        sc.close();
    }
}
### scanner-soma [stdin="3 4 5\n10\n"]
import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int soma = 0, n = 0;
        while (sc.hasNextInt()) { soma += sc.nextInt(); n++; }
        System.out.println("soma=" + soma + " n=" + n + " " + sc.hasNext());
    }
}
### scanner-validacao [stdin="abc\n-5\n42\n"]
import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int v = -1;
        while (v < 0) {
            System.out.print("Número positivo: ");
            if (sc.hasNextInt()) { v = sc.nextInt(); if (v < 0) System.out.println("negativo!"); }
            else { System.out.println("'" + sc.next() + "' não é número"); }
        }
        System.out.println("ok " + v);
    }
}
### scanner-us [stdin="3.5 1,5\n"]
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in).useLocale(Locale.US);
        System.out.println(sc.nextDouble());
        try { sc.nextDouble(); } catch (InputMismatchException e) { System.out.println("mismatch " + sc.next()); }
    }
}
