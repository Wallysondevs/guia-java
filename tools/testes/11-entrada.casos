### parse-erros
public class Main {
    public static void main(String[] args) {
        String[] xs = {"12", " 7", "3.5", "", "2147483648", "-0", "+5", "0x10"};
        for (String x : xs) {
            try { System.out.println(Integer.parseInt(x)); } catch (NumberFormatException e) { System.out.println(e.getMessage()); }
        }
        String[] ds = {"3.5", "3,5", "1e3", " 2.0 ", "abc", "NaN"};
        for (String d : ds) {
            try { System.out.println(Double.parseDouble(d)); } catch (NumberFormatException e) { System.out.println(e.getMessage()); }
        }
        Integer.parseInt("12a");
    }
}
