### unchecked-raw
import java.util.*;
public class Main {
    public static void main(String[] args) {
        List lista = new ArrayList();
        lista.add("a");
        System.out.println(lista);
    }
}
### nao-aplicavel
public class Main {
    static void f(int a) {}
    public static void main(String[] args) {
        f("a");
    }
}
### nao-aplicavel-aridade
public class Main {
    static void f(int a) {}
    public static void main(String[] args) {
        f(1, 2);
    }
}
### nenhum-adequado
public class Main {
    static void f(int a) {}
    static void f(double a, int b) {}
    public static void main(String[] args) {
        f("a");
    }
}
### metodo-inexistente
public class Main {
    public static void main(String[] args) {
        String s = "abc";
        s.foo();
        System.out.printn("x");
        Math.sqroot(2);
        int n = s.size();
    }
}
### classe-inexistente
