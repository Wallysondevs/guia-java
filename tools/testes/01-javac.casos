### switch-expr-nao-cobre
public class Main {
    public static void main(String[] args) {
        int d = 3;
        String s = switch (d) {
            case 1 -> "um";
            case 2 -> "dois";
        };
    }
}
### talvez-nao-inicializada
public class Main {
    public static void main(String[] args) {
        String s;
        if (args.length > 0) s = "a";
        System.out.println(s);
        int t;
        for (int i = 0; i < 3; i++) t = i;
        System.out.println(t);
    }
}
### catch-nunca
import java.io.*;
public class Main {
    public static void main(String[] args) {
        try {
            System.out.println("a");
        } catch (IOException e) {
        }
    }
}
### catch-ja-capturada
import java.io.*;
public class Main {
    static void f() throws IOException {}
    public static void main(String[] args) {
        try {
            f();
        } catch (Exception e) {
        } catch (IOException e) {
        }
    }
}
### multicatch-relacionadas
public class Main {
    public static void main(String[] args) {
        try {
            int x = 1;
        } catch (RuntimeException | ArithmeticException e) {
        }
    }
}
### lambda-efetivamente-final
import java.util.*;
public class Main {
    public static void main(String[] args) {
        int total = 0;
        List<Integer> l = List.of(1, 2);
        l.forEach(x -> total += x);
        Runnable r = new Runnable() { public void run() { total++; } };
    }
}
### lossy-composto
public class Main {
    public static void main(String[] args) {
        int x = 10;
        x += 2.7;
        byte b = 10;
        b = b + 1;
        short s = 100000;
        char c = 65;
        char d = -1;
        float f = 3.14;
        long g = 3000000000;
    }
}
