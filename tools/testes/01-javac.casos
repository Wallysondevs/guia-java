### abstrata
public class Main {
    static abstract class Animal { abstract String som(); }
    static class Cachorro extends Animal { }
    interface Forma { double area(); }
    static class Quadrado implements Forma { }
    public static void main(String[] args) {
        Animal a = new Animal();
    }
}
### privado
class Pessoa {
    private String nome;
    private void segredo() {}
}
public class Main {
    public static void main(String[] args) {
        Pessoa p = new Pessoa();
        p.nome = "Ana";
        p.segredo();
    }
}
### override-erro
public class Main {
    static class A { public void f() {} void g() {} }
    static class B extends A {
        void f() {}
        @Override void h() {}
        @Override public String toString() { return "B"; }
        @Override public boolean equals(B b) { return true; }
    }
    public static void main(String[] args) { }
}
### super-construtor
public class Main {
    static class Animal { String n; Animal(String n) { this.n = n; } }
    static class Gato extends Animal { Gato() { } }
    static class Cao extends Animal { }
    public static void main(String[] args) { }
}
### construtor-args
