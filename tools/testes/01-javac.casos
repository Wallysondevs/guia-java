### inalcancavel-break
public class Main {
    public static void main(String[] args) {
        for (int i = 0; i < 3; i++) {
            break;
            System.out.println(i);
        }
    }
}
### super-primeiro
public class Main {
    static class A { A(int x) {} }
    static class B extends A {
        B() {
            System.out.println("antes");
            super(1);
        }
    }
    public static void main(String[] args) { new B(); }
}
