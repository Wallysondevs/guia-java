    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
    }
}
### classe-aninhada-tipo
public class Main {
    static class Pessoa { String nome; }
    public static void main(String[] args) {
        Pessoa p = "Ana";
        int x = new Pessoa();
    }
}
### ordem-attr-flow
public class Main {
    static int f() { }
    public static void main(String[] args) {
        int x;
        System.out.println(x);
        String s = 5;
    }
}
### retorno-void
public class Main {
    static void f() { return 5; }
    static int g() { return; }
    static int h() { return "a"; }
    public static void main(String[] args) { }
}
### if-atribuicao
public class Main {
    public static void main(String[] args) {
        int x = 5;
        if (x = 5) System.out.println("a");
        while (1) {}
    }
}
### final-reatribui
public class Main {
    static final int MAX = 10;
    public static void main(String[] args) {
        final int x = 1;
        x = 2;
        MAX = 20;
        x++;
    }
}
### else-sem-if
public class Main {
    public static void main(String[] args) {
        int x = 5;
        if (x > 3) System.out.println("a");;
        else System.out.println("b");
    }
}
