### exc-propria
public class Main {
    static class SaldoException extends Exception {
        SaldoException(String m) { super(m); }
    }
    static void sacar() throws SaldoException { throw new SaldoException("saldo insuficiente"); }
    public static void main(String[] args) throws Exception {
        try { sacar(); } catch (SaldoException e) { System.out.println(e); System.out.println(e.getMessage()); }
        Object o = "x";
        Integer i = (Integer) o;
    }
}
### exc-causa
public class Main {
    public static void main(String[] args) {
        try {
            int[] a = new int[2];
            a[2] = 1;
        } catch (ArrayIndexOutOfBoundsException e) {
            throw new RuntimeException("falhou", e);
        }
    }
}
