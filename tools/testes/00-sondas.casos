### numeros
public class Main {
    public static void main(String[] args) {
        System.out.println(0.1 + 0.2);
        System.out.println(100.0 / 3);
        System.out.println(1e10);
        System.out.println(1e7);
        System.out.println(1234567.0);
        System.out.println(0.001);
        System.out.println(0.0001);
        System.out.println(1.0f / 3);
        System.out.println(Integer.MAX_VALUE + 1);
        System.out.println(Long.MAX_VALUE);
        System.out.println(-7 / 2 + " " + -7 % 2 + " " + 7 % -2);
        System.out.println('a' + 1);
        System.out.println((char) ('a' + 1));
        System.out.println(1.0 / 0 + " " + -1.0 / 0 + " " + 0.0 / 0);
        System.out.println(Double.MAX_VALUE + " " + Double.MIN_VALUE);
        System.out.println((int) 3.99 + " " + (int) -3.99 + " " + (int) 1e20);
        System.out.println(Math.round(2.5) + " " + Math.round(-2.5) + " " + Math.round(2.4f));
        System.out.printf("%.2f %d %s %5d|%-10s|%,d %n", 3.14159, 42, "oi", 7, "Ana", 1234567);
        System.out.println(String.format("%08.3f|%e|%x|%o|%c|%b|%10.2f|%+d", 3.14159, 12345.678, 255, 8, 'z', true, 2.5, 5));
    }
}
### scanner-pegadinha [stdin="29\nAna Souza\n3,5\n"]
import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Idade: ");
        int idade = sc.nextInt();
        System.out.print("Nome: ");
        String nome = sc.nextLine();
        System.out.println("[" + nome + "]");
        String n2 = sc.nextLine();
        double d = sc.nextDouble();
        System.out.println(idade + " " + n2 + " " + d);
    }
}
