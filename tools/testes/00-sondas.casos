### hashmap-ordem
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Map<String, Integer> m = new HashMap<>();
        for (String s : new String[]{"banana", "maçã", "uva", "laranja", "abacaxi", "pera", "kiwi", "manga", "melão", "ameixa", "goiaba", "caju", "acerola", "figo"}) m.put(s, s.length());
        System.out.println(m);
        Set<Integer> hs = new HashSet<>(List.of(100, 5, 17, 33, 1000, -4, 64));
        System.out.println(hs);
        System.out.println(new Object().toString().startsWith("java.lang.Object@"));
        System.out.println(List.of(1, 2.0, "a", 'c'));
    }
}
