### var-local
import java.util.*;
public class Main {
    public static void main(String[] args) {
        var nome = "Ana";
        var idade = 29;
        var media = 8.5;
        var lista = new ArrayList<String>();
        lista.add(nome);
        var mapa = new HashMap<String, Integer>();
        mapa.put(nome, idade);
        for (var e : mapa.entrySet()) System.out.println(e.getKey() + "=" + e.getValue());
        var c = 'x';
        var l = 10L;
        System.out.println(nome + idade + media + lista + c + l);
        for (var i = 0; i < 2; i++) System.out.print(i);
        System.out.println();
    }
}
