### char-tabela
public class Main {
    public static void main(String[] args) {
        for (char c = 'a'; c <= 'e'; c++) System.out.print(c + "=" + (int) c + " ");
        System.out.println();
        char c = 'x';
        c += 1;
        System.out.println(c + " " + Character.toUpperCase(c) + " " + Character.isDigit('5') + " " + Character.isLetter('5') + " " + Character.isWhitespace(' '));
        System.out.println((char) ('A' + 2) + " " + (int) 'Z' + " " + ('a' < 'b') + " " + Character.getNumericValue('9') + " " + ('7' - '0'));
        String s = "Olá 123";
        int letras = 0, digitos = 0;
        for (char ch : s.toCharArray()) { if (Character.isLetter(ch)) letras++; else if (Character.isDigit(ch)) digitos++; }
        System.out.println(letras + " " + digitos + " " + 'A' + " " + "\t|" + "\\" + "\"");
    }
}
### decimais
public class Main {
    public static void main(String[] args) {
        double a = 0.1, b = 0.2;
        System.out.println(a + b + " " + (a + b == 0.3) + " " + Math.abs(a + b - 0.3) < 1e-9 + "");
        System.out.println(10 / 4 + " " + 10 / 4.0 + " " + 10.0 / 4 + " " + (double) (10 / 4));
        float f = 1.1f;
        System.out.println(f + " " + (double) f + " " + f * 3 + " " + 1.0f / 3);
        System.out.println(1.0 / 0 + " " + -1.0 / 0 + " " + 0.0 / 0 + " " + Double.isNaN(0.0 / 0));
        System.out.println(100.0 + " " + 1e3 + " " + 123456789.0 + " " + 0.00001 + " " + 1.5e-5 + " " + 3.0e20);
        System.out.println((int) 9.99 + " " + Math.round(9.5) + " " + Math.floor(-1.5) + " " + Math.ceil(-1.5) + " " + (long) -2.5);
        double preco = 19.9;
        System.out.println(preco * 3 + " " + String.format("%.2f", preco * 3));
        System.out.println(Double.MAX_VALUE * 2 + " " + Double.MIN_VALUE / 2 + " " + (float) 1e40 + " " + (0.1f + 0.2f));
    }
}
### wrappers
public class Main {
    public static void main(String[] args) {
        Integer a = 127, b = 127, c = 128, d = 128;
        System.out.println((a == b) + " " + (c == d) + " " + c.equals(d) + " " + (c.intValue() == d));
        Long l1 = 10L, l2 = 10L;
        System.out.println((l1 == l2) + " " + l1.equals(10) + " " + l1.equals(10L));
        Integer n = null;
        int x = Integer.parseInt("42") + Integer.valueOf(8);
        Double dd = 2.5;
        double soma = dd + x;
        System.out.println(x + " " + soma + " " + Integer.toString(255, 2) + " " + Integer.toHexString(255) + " " + Integer.MAX_VALUE);
        Character ch = 'a';
        Boolean bo = true;
        System.out.println(ch + " " + bo + " " + Character.valueOf('z').compareTo('a') + " " + Boolean.parseBoolean("TRUE"));
        System.out.println(Integer.compare(5, 3) + " " + Double.compare(1.0, 2.0) + " " + Integer.valueOf(5).hashCode() + " " + Double.valueOf(1.5).hashCode() + " " + "ab".hashCode() + " " + Boolean.TRUE.hashCode());
        Object o = 5;
        System.out.println(o.getClass().getName() + " " + (o instanceof Integer) + " " + ((Object) 5.0).getClass().getSimpleName());
        try { int y = n; } catch (NullPointerException e) { System.out.println("NPE"); }
    }
}
### object-metodos
public class Main {
    static class Ponto {
        int x, y;
        Ponto(int x, int y) { this.x = x; this.y = y; }
        @Override public boolean equals(Object o) {
            if (this == o) return true;
            if (!(o instanceof Ponto)) return false;
            Ponto p = (Ponto) o;
            return x == p.x && y == p.y;
        }
        @Override public int hashCode() { return java.util.Objects.hash(x, y); }
        @Override public String toString() { return "(" + x + ", " + y + ")"; }
    }
    public static void main(String[] args) {
        Ponto a = new Ponto(1, 2), b = new Ponto(1, 2);
        System.out.println(a + " " + a.equals(b) + " " + (a == b) + " " + a.hashCode() + " " + (a.hashCode() == b.hashCode()));
        System.out.println(a.getClass().getName() + " " + a.getClass().getSimpleName());
        java.util.Set<Ponto> s = new java.util.HashSet<>();
        s.add(a); s.add(b); s.add(new Ponto(2, 1));
        System.out.println(s.size() + " " + s);
        Object o = a;
        System.out.println(o.toString() + " " + String.valueOf(o));
    }
}
