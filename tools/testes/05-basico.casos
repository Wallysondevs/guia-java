### casting
public class Main {
    public static void main(String[] args) {
        double d = 9.78;
        int i = (int) d;
        long l = i;
        float f = l;
        byte b = (byte) 300;
        short s = (short) 70000;
        char c = (char) 66;
        int fromChar = 'C';
        System.out.println(i + " " + l + " " + f + " " + b + " " + s + " " + c + " " + fromChar);
        System.out.println((int) 3.5e10 + " " + (long) 3.5e10 + " " + (int) Double.NaN + " " + (char) 97.9 + " " + (byte) -1.5);
        int grande = 123456789;
        float fg = grande;
        System.out.println(fg + " " + (int) fg + " " + (double) 1 / 3);
        Object o = "texto";
        String str = (String) o;
        System.out.println(str.length());
        long ll = Long.MAX_VALUE;
        System.out.println((int) ll + " " + (double) ll + " " + (float) ll);
    }
}
### math2
public class Main {
    public static void main(String[] args) {
        System.out.println(Math.max(Integer.MIN_VALUE, -5) + " " + Math.min(-0.0, 0.0) + " " + Math.pow(0, 0) + " " + Math.sqrt(2) * Math.sqrt(2));
        System.out.println(Math.round(-0.5) + " " + Math.round(0.49999999999999994) + " " + Math.round(1.5f) + " " + Math.abs(-0.0));
        System.out.println(Math.floorDiv(7, -2) + " " + Math.floorMod(7, -2) + " " + (7 / -2) + " " + (7 % -2));
        System.out.println(Math.toDegrees(Math.PI) + " " + Math.sin(0) + " " + Math.cos(Math.PI) + " " + Math.tan(Math.PI / 4));
        System.out.println(Math.log(1) + " " + Math.exp(0) + " " + Math.log10(0.001) + " " + Math.cbrt(-8) + " " + Math.hypot(5, 12));
        int dado = (int) (0.999 * 6) + 1;
        System.out.println(dado + " " + Math.signum(0.0) + " " + Math.ceil(0.000001) + " " + Math.rint(3.5) + " " + Math.rint(4.5));
    }
}
### random-semente
import java.util.Random;
public class Main {
    public static void main(String[] args) {
        Random r = new Random(42);
        for (int i = 0; i < 5; i++) System.out.print(r.nextInt(100) + " ");
        System.out.println();
        Random r2 = new Random(2026);
        System.out.println((r2.nextInt(6) + 1) + " " + r2.nextInt(10, 21) + " " + r2.nextInt(10, 21) + " " + r2.nextInt(10, 21));
        Random r3 = new Random(7);
        System.out.println(r3.nextInt(6) + " " + r3.nextInt(6) + " " + r3.nextInt(6));
        Random r4 = new Random(123);
        System.out.println(r4.nextDouble() + " " + r4.nextBoolean() + " " + r4.nextLong() + " " + r4.nextInt() + " " + r4.nextGaussian() + " " + r4.nextFloat());
        Random r5 = new Random(0);
        System.out.println(r5.nextInt(1, 7) + " " + r5.nextInt(16) + " " + r5.nextInt(1000) + " " + r5.nextDouble(5.0));
        java.util.List<Integer> l = new java.util.ArrayList<>(java.util.List.of(1, 2, 3, 4, 5, 6, 7, 8));
        java.util.Collections.shuffle(l, new Random(42));
        System.out.println(l);
    }
}
### printf-mais
public class Main {
    public static void main(String[] args) {
        String[] nomes = {"Ana", "Bruno", "Carla"};
        double[] notas = {9.5, 7.25, 10};
        for (int i = 0; i < 3; i++) System.out.printf("%-8s|%6.2f|%3d%%%n", nomes[i], notas[i], (int) (notas[i] * 10));
        System.out.printf("%s tem %d anos e mede %.2f m%n", "Ana", 29, 1.68);
        System.out.println(String.format("%05d|%5s|%-5s|%.3e|%,.1f", 42, "ab", "cd", 0.000123456, 9876543.21));
        System.out.printf("%b %c %x %o %h%n", "x", 'Y', 31, 31, 31);
        System.out.printf("Total: R$ %.2f%n", 1234.5);
        System.out.printf("%.0f %.0f %.1f %.1f%n", 2.5, 3.5, 0.05, 0.15);
        System.out.println(String.format("%10.3f|%-10.1f|%+.2f|% d", Math.E, -1.25, 3.0, 42));
    }
}
