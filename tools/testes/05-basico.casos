### str-metodos
public class Main {
    public static void main(String[] args) {
        String s = "  Olá, Mundo Java  ";
        System.out.println("[" + s.trim() + "] [" + s.strip() + "] " + s.length() + " " + s.isBlank());
        String t = "banana";
        System.out.println(t.indexOf('a') + " " + t.lastIndexOf("an") + " " + t.indexOf("x") + " " + t.charAt(2) + " " + t.substring(2) + " " + t.substring(1, 4));
        System.out.println(t.replace('a', 'o') + " " + t.replace("an", "AN") + " " + t.toUpperCase() + " " + "ABC".toLowerCase());
        System.out.println(t.contains("nan") + " " + t.startsWith("ba") + " " + t.endsWith("na") + " " + t.equals("Banana") + " " + t.equalsIgnoreCase("BANANA"));
        System.out.println("b".compareTo("a") + " " + "a".compareTo("b") + " " + "apple".compareTo("apricot") + " " + "ab".compareTo("abc"));
        System.out.println(String.join("-", "a", "b", "c") + " " + "x".repeat(3) + " " + "a,b,,c".split(",").length + " " + "".isEmpty());
        for (String p : "um dois  três".split(" ")) System.out.print("[" + p + "]");
        System.out.println();
        System.out.println(String.valueOf(3.0) + String.valueOf(true) + String.valueOf('c') + String.valueOf(10L));
        char[] cs = "abc".toCharArray();
        System.out.println(cs.length + " " + new String(cs) + " " + String.valueOf(cs, 0, 2));
        System.out.println("Java".chars().count() + " " + "a-b-c".replaceAll("-", "+") + " " + "Aaa".matches("A.*"));
    }
}
### str-igualdade
public class Main {
    public static void main(String[] args) {
        String a = "Java";
        String b = "Java";
        String c = new String("Java");
        String d = "Ja" + "va";
        String e = "Ja";
        String f = e + "va";
        final String g = "Ja";
        String h = g + "va";
        System.out.println((a == b) + " " + (a == c) + " " + (a == d) + " " + (a == f) + " " + (a == h) + " " + (a == f.intern()) + " " + a.equals(c));
        String x = "java" + 25;
        System.out.println(x == "java25");
    }
}
### sb-basico
public class Main {
    public static void main(String[] args) {
        StringBuilder sb = new StringBuilder("abc");
        sb.append(1).append('x').append(2.5).append(true).append(" fim");
        System.out.println(sb + " " + sb.length());
        sb.insert(0, "[").append("]");
        System.out.println(sb);
        System.out.println(sb.reverse());
        sb.setLength(3);
        System.out.println(sb + " " + sb.charAt(1) + " " + sb.indexOf("u"));
        StringBuilder s2 = new StringBuilder("Olá Mundo");
        s2.delete(0, 4).deleteCharAt(0).replace(0, 1, "MM");
        System.out.println(s2 + " " + s2.toString().equals("MMndo"));
        StringBuilder vazio = new StringBuilder();
        for (int i = 0; i < 5; i++) vazio.append(i).append(i < 4 ? "," : "");
        System.out.println(vazio);
    }
}
### operadores
public class Main {
    public static void main(String[] args) {
        int a = 17, b = 5;
        System.out.println(a + b + " " + (a - b) + " " + a * b + " " + a / b + " " + a % b + " " + (double) a / b);
        System.out.println(a > b && b > 0 || a < 0);
        System.out.println(!(a == b) + " " + (a != b) + " " + (a >= 17) + " " + (b <= 4));
        int x = 10;
        x += 5; System.out.print(x + " ");
        x -= 3; System.out.print(x + " ");
        x *= 2; System.out.print(x + " ");
        x /= 5; System.out.print(x + " ");
        x %= 3; System.out.println(x);
        int i = 5;
        int j = i++ + ++i;
        System.out.println(i + " " + j + " " + (i-- - --i) + " " + i);
        boolean t = true, f = false;
        System.out.println((t & f) + " " + (t | f) + " " + (t ^ f) + " " + (t ^ t));
        System.out.println(2 + 3 * 4 + " " + (2 + 3) * 4 + " " + 10 - 2 - 3);
        System.out.println(1 + 2 + "3" + 4 + 5);
        System.out.println(7 > 3 ? "maior" : "menor");
        int idade = 17;
        String r = idade >= 18 ? "adulto" : idade >= 12 ? "adolescente" : "criança";
        System.out.println(r);
    }
}
### if-else
public class Main {
    public static void main(String[] args) {
        int[] notas = {95, 82, 71, 64, 30};
        for (int n : notas) {
            if (n >= 90) System.out.println(n + ": A");
            else if (n >= 80) System.out.println(n + ": B");
            else if (n >= 70) System.out.println(n + ": C");
            else {
                System.out.println(n + ": reprovado");
            }
        }
    }
}
### switch-classico
public class Main {
    public static void main(String[] args) {
        for (int d = 1; d <= 8; d++) {
            switch (d) {
                case 1:
                    System.out.print("dom ");
                    break;
                case 2: case 3: case 4: case 5: case 6:
                    System.out.print("útil ");
                    break;
                case 7:
                    System.out.print("sáb ");
                default:
                    System.out.print("? ");
            }
        }
        System.out.println();
        String fruta = "uva";
        switch (fruta) {
            case "maçã" -> System.out.println("vermelha");
            case "uva", "amora" -> System.out.println("roxa");
            default -> System.out.println("outra");
        }
        char c = 'b';
        switch (c) { case 'a': System.out.println("A"); break; case 'b': System.out.println("B"); }
    }
}
### switch-expr
public class Main {
    enum Dia { SEG, TER, QUA, QUI, SEX, SAB, DOM }
    public static void main(String[] args) {
        for (Dia d : Dia.values()) {
            String tipo = switch (d) {
                case SAB, DOM -> "fim de semana";
                default -> "dia útil";
            };
            int horas = switch (d) {
                case SEG, TER, QUA, QUI -> 8;
                case SEX -> { int h = 6; yield h; }
                case SAB, DOM -> 0;
            };
            System.out.println(d + " " + d.ordinal() + " " + tipo + " " + horas);
        }
        int mes = 2;
        int dias = switch (mes) { case 2: yield 28; case 4, 6, 9, 11: yield 30; default: yield 31; };
        System.out.println(dias);
    }
}
### lacos
public class Main {
    public static void main(String[] args) {
        int i = 0;
        while (i < 3) { System.out.print(i + " "); i++; }
        System.out.println();
        do { System.out.print(i + " "); i--; } while (i > 0);
        System.out.println();
        for (int a = 0, b = 10; a < b; a += 3, b -= 2) System.out.print(a + ":" + b + " ");
        System.out.println();
        fora:
        for (int x = 1; x <= 3; x++) {
            for (int y = 1; y <= 3; y++) {
                if (y == 2) continue;
                if (x == 3) break fora;
                System.out.print(x + "" + y + " ");
            }
        }
        System.out.println();
        int soma = 0;
        for (int k = 1; k <= 100; k++) { if (k % 2 == 0) continue; soma += k; }
        System.out.println(soma);
        for (int k = 1; k <= 3; k++) { for (int m = 1; m <= k; m++) System.out.print("*"); System.out.println(); }
    }
}
### arrays-basico
import java.util.Arrays;
public class Main {
    public static void main(String[] args) {
        int[] a = new int[5];
        double[] d = new double[2];
        String[] s = new String[2];
        boolean[] b = new boolean[1];
        char[] c = new char[2];
        System.out.println(Arrays.toString(a) + Arrays.toString(d) + Arrays.toString(s) + Arrays.toString(b) + (int) c[0]);
        int[] v = {5, 3, 9, 1};
        Arrays.sort(v);
        System.out.println(Arrays.toString(v) + " " + Arrays.binarySearch(v, 9) + " " + v.length);
        int[][] m = {{1, 2, 3}, {4, 5, 6}};
        System.out.println(m.length + " " + m[0].length + " " + m[1][2] + " " + Arrays.deepToString(m));
        int[][] irregular = new int[3][];
        irregular[0] = new int[]{1};
        irregular[1] = new int[]{1, 2};
        System.out.println(Arrays.deepToString(irregular));
        int[] copia = Arrays.copyOf(v, 6);
        int[] parte = Arrays.copyOfRange(v, 1, 3);
        Arrays.fill(a, 7);
        System.out.println(Arrays.toString(copia) + Arrays.toString(parte) + Arrays.toString(a) + Arrays.equals(v, new int[]{1, 3, 5, 9}));
        String[] nomes = {"Carla", "ana", "Bruno"};
        Arrays.sort(nomes);
        System.out.println(Arrays.toString(nomes));
        Integer[] nums = {3, 1, 2};
        Arrays.sort(nums, java.util.Collections.reverseOrder());
        System.out.println(Arrays.toString(nums) + " " + Arrays.asList(nums) + " " + Arrays.stream(v).sum());
        int[] ref = v;
        ref[0] = 100;
        System.out.println(v[0] + " " + (ref == v) + " " + v.equals(ref) + " " + Arrays.toString(v.clone()));
    }
}
### array-excecoes
public class Main {
    public static void main(String[] args) {
        int[] a = new int[3];
        try { a[3] = 1; } catch (ArrayIndexOutOfBoundsException e) { System.out.println(e.getMessage()); }
        try { a[-1] = 1; } catch (ArrayIndexOutOfBoundsException e) { System.out.println(e); }
        try { int[] b = new int[-2]; } catch (NegativeArraySizeException e) { System.out.println(e); }
        Object[] o = new String[1];
        try { o[0] = 1; } catch (ArrayStoreException e) { System.out.println(e); }
        String s = "abc";
        try { s.charAt(5); } catch (StringIndexOutOfBoundsException e) { System.out.println(e.getMessage()); }
        try { s.substring(2, 1); } catch (StringIndexOutOfBoundsException e) { System.out.println(e.getMessage()); }
        try { s.substring(4); } catch (StringIndexOutOfBoundsException e) { System.out.println(e.getMessage()); }
    }
}
### metodos-sobrecarga
public class Main {
    static int soma(int a, int b) { return a + b; }
    static double soma(double a, double b) { return a + b; }
    static int soma(int a, int b, int c) { return a + b + c; }
    static String soma(String a, String b) { return a + b; }
    static void f(long x) { System.out.println("long " + x); }
    static void f(Integer x) { System.out.println("Integer " + x); }
    static void f(Object x) { System.out.println("Object " + x); }
    static void g(double x) { System.out.println("double " + x); }
    static void h(int... xs) { System.out.println("varargs " + xs.length); }
    static void h(int a, int b) { System.out.println("dois"); }
    public static void main(String[] args) {
        System.out.println(soma(1, 2) + " " + soma(1.5, 2) + " " + soma(1, 2, 3) + " " + soma("a", "b"));
        f(5); f(5L); f("x"); f('c');
        g(3); g('A');
        h(); h(1); h(1, 2); h(1, 2, 3);
        byte bt = 10; f(bt);
    }
}
### recursao
public class Main {
    static long fat(int n) { return n <= 1 ? 1 : n * fat(n - 1); }
    static int fib(int n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); }
    static int mdc(int a, int b) { return b == 0 ? a : mdc(b, a % b); }
    static void hanoi(int n, char de, char para, char aux) {
        if (n == 0) return;
        hanoi(n - 1, de, aux, para);
        System.out.print(de + "" + para + " ");
        hanoi(n - 1, aux, para, de);
    }
    public static void main(String[] args) {
        System.out.println(fat(20) + " " + fat(21) + " " + fib(20) + " " + mdc(84, 36));
        hanoi(3, 'A', 'C', 'B');
        System.out.println();
    }
}
