        List<Integer> m = new ArrayList<>(List.of("a"));
    }
}
### groupingby-treemap
import java.util.*;
import java.util.stream.*;
public class Main {
    record Aluno(String nome, String cidade) {}
    public static void main(String[] args) {
        List<Aluno> l = List.of(new Aluno("a", "Recife"), new Aluno("b", "Natal"), new Aluno("c", "Recife"));
        Map<String, Long> m = l.stream().collect(Collectors.groupingBy(Aluno::cidade, TreeMap::new, Collectors.counting()));
        System.out.println(m);
        Map<String, List<String>> n = l.stream().collect(Collectors.groupingBy(Aluno::cidade, Collectors.mapping(Aluno::nome, Collectors.toList())));
        System.out.println(n);
        Map<Boolean, Long> p = l.stream().collect(Collectors.partitioningBy(a -> a.cidade().equals("Recife"), Collectors.counting()));
        System.out.println(p);
        System.out.println(l.stream().map(Aluno::nome).collect(Collectors.joining(", ", "[", "]")));
        System.out.println(l.stream().sorted(Comparator.comparing(Aluno::cidade).reversed().thenComparing(Aluno::nome)).toList());
        System.out.println(l.stream().collect(Collectors.toMap(Aluno::nome, Aluno::cidade)));
        System.out.println(IntStream.rangeClosed(1, 5).boxed().collect(Collectors.toList()));
        System.out.println(Stream.of("a", "bb", "ccc").collect(Collectors.groupingBy(String::length, Collectors.counting())));
        System.out.println(l.stream().mapToInt(a -> a.nome().length()).summaryStatistics());
        System.out.println(Stream.of(1.5, 2.5).collect(Collectors.averagingDouble(d -> d)));
    }
}
