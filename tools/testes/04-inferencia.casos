### limites-incompativeis
import java.util.*;
interface Pagavel { double valor(); }
class Boleto implements Pagavel { public double valor() { return 1; } }
class Luz { }
public class Main {
    public static void main(String[] args) {
        List<Pagavel> contas = List.of(new Boleto(), new Luz());
    }
}
