### printf-varios
public class Main {
    public static void main(String[] args) {
        System.out.printf("%5.1f|%-8.3f|%08d|%+.1f|%(d|%x|%X|%10s|%-5b|%c%n", 3.14159, 2.5, 42, -1.25, -7, 255, 255, "dir", true, 65);
        System.out.printf("%.0f %.0f %.0f %.1f %.2f %.3f%n", 0.5, 1.5, 2.5, 0.05, 1.005, 2.0005);
        System.out.printf("%e %.2e %g %.3g %a%n", 123.456, 0.000123, 123.456, 0.0001234, 1.0);
        System.out.printf("%s %S %h %n", null, "abc", "hi");
        System.out.printf("%,.2f %,d %d%n", 1234567.891, -1234567, Long.MIN_VALUE);
        System.out.printf("%2$s %1$s %<s%n", "a", "b");
        System.out.printf("%%|%n");
        System.out.println(String.format("%.2f", 2.675) + " " + String.format("%.1f", 0.25) + " " + String.format("%.1f", 0.35));
        System.out.println(String.format("%10.4f|%-10d|%x", Math.PI, 5, -1));
        System.out.println(String.format("%s %s %s", 1.0, 1.0f, 'x'));
        System.out.println(String.format("%.3s|%5.2s|", "abcdef", "xyz"));
        System.out.println(String.format("%b %b %b", null, "x", false));
        System.out.println(String.format("%o %x %X", 8, 255L, 3000000000L));
        System.out.println(String.format("%f %f", 1.0, 1e10));
    }
}
