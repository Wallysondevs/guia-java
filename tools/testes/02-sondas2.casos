### npe-varios
import java.util.*;
public class Main {
    String nome;
    static String est;
    static List<String> lista;
    int[] arr;
    static String f() { return null; }
    public static void main(String[] args) {
        Main m = new Main();
        try { m.nome.length(); } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { est.isEmpty(); } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { lista.size(); } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { f().trim(); } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { int x = m.arr[0]; } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { int x = m.arr.length; } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        Main q = null;
        try { q.nome = "a"; } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { String s = q.nome; } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        Integer i = null;
        try { int y = i; } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { throw null; } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        String[] ss = new String[2];
        try { ss[1].length(); } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        long a = 1; double b = 2; String c = null;
        try { c.charAt(0); } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { m.g(null); } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { Objects.requireNonNull(null, "nao pode"); } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { String.valueOf((Object) null).length(); System.out.println("ok"); } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { switch (c) { default -> {} } } catch (NullPointerException e) { System.out.println(e.getMessage()); }
        try { "a".equals(null); c.equals("a"); } catch (NullPointerException e) { System.out.println(e.getMessage()); }
    }
    void g(String p) { p.toUpperCase(); }
}
