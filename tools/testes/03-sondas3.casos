### lista-erros
import java.util.*;
public class Main {
    public static void main(String[] args) {
        List<Integer> l = new ArrayList<>(List.of(1, 2, 3));
        try { l.get(5); } catch (IndexOutOfBoundsException e) { System.out.println(e); }
        try { List.of(1).add(2); } catch (UnsupportedOperationException e) { System.out.println(e); }
        try { for (Integer x : l) if (x == 2) l.remove(x); } catch (ConcurrentModificationException e) { System.out.println(e); }
        Map<String,Integer> m = new HashMap<>();
        m.put("a", 1);
        int v = m.get("b");
    }
}
