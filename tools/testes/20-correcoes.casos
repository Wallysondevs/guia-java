### e-sort-nao-comparable-lista-de
import java.util.*;
public class Main {
    record Item(String nome) {}
    public static void main(String[] args) {
        List<Item> it = new ArrayList<>(List.of(new Item("b"), new Item("a")));
        Collections.sort(it);
        it.sort(null);
        System.out.println(it);
    }
}
